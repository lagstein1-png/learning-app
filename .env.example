# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
SERVICE_NAME=learning-app-tts
# Comma separated origins allowed by CORS. Native mobile clients send no Origin
# header and are always allowed; this list governs web/PWA clients.
CORS_ORIGINS=https://lagstein1-png.github.io,http://localhost:5173
# Shared secret mobile clients present in `x-api-key`. Leave empty to disable.
CLIENT_API_KEY=

# ── Gemini (Google AI Studio) — linguistic pre-processing ─────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 disables Gemini entirely (rule-based preprocessing only).
GEMINI_ENABLED=1
GEMINI_TIMEOUT_MS=12000

# ── Supabase — user state, overrides, audio cache ─────────────────────────
SUPABASE_URL=
# Service-role key: this backend is the only Supabase client; never ship it to a device.
SUPABASE_SERVICE_ROLE_KEY=

# ── Neural voice providers (any subset; the engine falls through in order) ─
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GOOGLE_TTS_API_KEY=
# Provider order, comma separated: azure,google
TTS_PROVIDER_ORDER=azure,google
TTS_TIMEOUT_MS=20000
TTS_MAX_RETRIES=3
# Per-provider rate limit: requests per minute and concurrent in-flight calls
TTS_RATE_LIMIT_RPM=120
TTS_MAX_CONCURRENCY=4

# ── Audio cache ───────────────────────────────────────────────────────────
AUDIO_CACHE_MAX_ITEMS=500
AUDIO_CACHE_TTL_SECONDS=604800
