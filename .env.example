# ---- Server ----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Comma-separated list of allowed browser origins. Empty = no CORS headers.
ALLOW_ORIGINS=
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=60

# ---- Providers (keys live ONLY here or in the host's secret store) ----------
# Primary route: gemini | anthropic
PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
# Used when Anthropic is the primary route.
ANTHROPIC_MODEL=claude-opus-5
# Lightweight secondary route when Anthropic is the fallback.
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5
# Per-attempt timeout for one provider call, milliseconds.
PROVIDER_TIMEOUT_MS=20000
# After this many consecutive failures a route is skipped for COOLDOWN ms.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=60000

# ---- Semantic cache ---------------------------------------------------------
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.80
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=2000

# ---- Budgets (tokens; USD only if a price table is configured) --------------
DAILY_TOKEN_BUDGET=2000000
MAX_TOKENS_PER_REQUEST=4000
# Optional JSON: {"claude-opus-5":{"input_per_1m":5,"output_per_1m":25}}
PRICE_TABLE_JSON=
