# Copy to .env and fill in. Never commit .env.

# Anthropic API key for the text pre-processing module (Step 2).
# Leave empty on a machine that is logged in to Claude Code: the pipeline then
# routes pre-processing through the Claude Agent SDK, which reuses that login.
ANTHROPIC_API_KEY=

# Model used by both the pre-processor and the learning coach.
ANTHROPIC_MODEL=claude-opus-5

# auto | anthropic | agent-sdk | local
#   auto      -> anthropic when a key is present, otherwise agent-sdk
#   local     -> deterministic offline normalisation only (no LLM)
PREPROCESS_BACKEND=auto

# Effort levels: low | medium | high | xhigh | max
PREPROCESS_EFFORT=medium
COACH_EFFORT=medium

# Hard spending ceiling per learning session (USD), enforced by the Agent SDK.
COACH_MAX_BUDGET_USD=2.0

# Where the MCP materials server may read from, and where session state lives.
LEARNING_MATERIALS_DIR=./materials
LEARNING_STATE_DIR=./state

# Longest text handed to one pre-processing call; longer texts are chunked.
TTS_MAX_CHARS=6000
