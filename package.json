{
  "name": "accessible-learning-backend",
  "version": "1.0.0",
  "description": "Accessible, multilingual (he/en/es/ar) AI learning backend: structured LLM output, pronunciation guardrails, semantic cache, tool routing and fallbacks.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
